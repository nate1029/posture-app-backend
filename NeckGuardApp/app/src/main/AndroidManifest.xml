<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Required Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- SCHEDULE_EXACT_ALARM removed: the fallback setAndAllowWhileIdle() path
         is sufficient for service-restart timing, and the permission triggers
         Play Store review scrutiny on Android 14+ without real benefit. -->

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />

    <application
        android:name=".NeckGuardApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NeckGuard"
        android:usesCleartextTraffic="false">
        
        <!-- Foreground Service Registration -->
        <service 
            android:name=".service.NeckGuardService" 
            android:enabled="true" 
            android:exported="false"
            android:foregroundServiceType="health" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:label="@string/app_name"
            android:theme="@style/Theme.NeckGuard">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Deep link handler for Firebase Magic Link (passwordless email sign-in).
                 When the user clicks the sign-in link in their email, this intent filter
                 routes the request to MainActivity, which completes the auth flow. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https"
                    android:host="nudgeup-4aa6e.firebaseapp.com"
                    android:pathPrefix="/__/auth/action" />
            </intent-filter>
            <!-- Fallback interception for the continue URL if Chrome processes the link -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https"
                    android:host="nudgeup-4aa6e.firebaseapp.com"
                    android:path="/login" />
            </intent-filter>
        </activity>

        <!-- The Transparent Workaround Activity -->
        <activity
            android:name=".CheckPostureActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:screenOrientation="portrait"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Auto-Start on Phone Reboot -->
        <receiver
            android:name=".service.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </receiver>

        <!-- Service Revive Relay: AlarmManager → this receiver → startForegroundService() -->
        <!-- Needed because Android 12+ blocks direct service starts from alarm callbacks -->
        <receiver
            android:name=".service.ServiceRestartReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="com.example.neckguard.RESTART_SERVICE" />
            </intent-filter>
        </receiver>

        <!-- Firebase Cloud Messaging Receiver for Remote Dashboard Pushes.
             android:exported is intentionally false: only Google Play Services
             dispatches MESSAGING_EVENT, and it does so via a privileged binder
             channel that doesn't require the receiver to be exported. -->
        <service
            android:name=".service.NeckGuardFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>

</manifest>
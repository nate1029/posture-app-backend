<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Required Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Strip ACTIVITY_RECOGNITION injected by a transitive dependency's merged
         manifest. The app reads accelerometer/gyroscope directly and has no
         activity-recognition feature, but the permission alone triggers Google
         Play's "Health apps" classification, which forces an organization
         developer account. tools:node="remove" guarantees it never ships in the
         final AAB regardless of dependency version resolution. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION"
        tools:node="remove" />

    <!-- SCHEDULE_EXACT_ALARM removed: the fallback setAndAllowWhileIdle() path
         is sufficient for service-restart timing, and the permission triggers
         Play Store review scrutiny on Android 14+ without real benefit. -->

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />

    <application
        android:name=".NeckGuardApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NeckGuard"
        android:usesCleartextTraffic="false">
        
        <!-- Foreground Service Registration -->
        <service 
            android:name=".service.NeckGuardService" 
            android:enabled="true" 
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Posture sensor monitoring using accelerometer and gyroscope" />
        </service>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:label="@string/app_name"
            android:theme="@style/Theme.NeckGuard">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The Transparent Workaround Activity -->
        <activity
            android:name=".CheckPostureActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:screenOrientation="portrait"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Posture Insight Screen — "Why was my posture bad?" -->
        <activity
            android:name=".PostureInsightActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.NeckGuard" />

        <!-- Auto-Start on Phone Reboot -->
        <receiver
            android:name=".service.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </receiver>

        <!-- Service Revive Relay: AlarmManager → this receiver → startForegroundService() -->
        <!-- Needed because Android 12+ blocks direct service starts from alarm callbacks -->
        <receiver
            android:name=".service.ServiceRestartReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="com.example.neckguard.RESTART_SERVICE" />
            </intent-filter>
        </receiver>

        <!-- Firebase Cloud Messaging Receiver for Remote Dashboard Pushes.
             android:exported is intentionally false: only Google Play Services
             dispatches MESSAGING_EVENT, and it does so via a privileged binder
             channel that doesn't require the receiver to be exported. -->
        <service
            android:name=".service.NeckGuardFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>

</manifest>